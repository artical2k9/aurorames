# Aurora MES Infrastructure Environment Variables
# Copy this file to .env and populate all required values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Keycloak admin credentials ────────────────────────────────────────────────
# Used only for the Keycloak admin console and Admin REST API.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Webhook shared secret — must match the value set in the Keycloak admin console
# under Realm Settings → Events → http-sender provider → sharedSecret.
# Must also match the IAM_WEBHOOK_TOKEN value used by iam-service.
# Generate with: openssl rand -hex 40
KEYCLOAK_WEBHOOK_SECRET=

# ── IAM Service ───────────────────────────────────────────────────────────────
IAM_DB_URL=jdbc:postgresql://localhost:5432/mes
IAM_DB_USER=iam_user
IAM_DB_PASSWORD=

# The webhook token validated by WebhookTokenFilter on /internal/keycloak-events.
# Must match KEYCLOAK_WEBHOOK_SECRET above.
IAM_WEBHOOK_TOKEN=

# The IAM service's own M2M client secret (set in Keycloak after realm import:
# Clients → iam-service-m2m → Credentials → Client secret).
IAM_SERVICE_CLIENT_SECRET=

# URL of iam-service, used by lib-common-security's PrivilegeRegistryClient.
IAM_SERVICE_URL=http://localhost:8085

# Privilege cache TTL in seconds (default 60).
PRIVILEGE_CACHE_TTL=60

# ── Keycloak OIDC settings (used by all services) ────────────────────────────
# Replace with your actual Keycloak host in production.
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/mes
# Issuer URI used by services for JWT iss-claim validation (string comparison, no OIDC discovery).
# Must match the iss claim in tokens issued by Keycloak — typically the public-facing URL.
KEYCLOAK_EXTERNAL_URL=http://localhost:8080/realms/mes
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=mes

# ── Gateway Service ───────────────────────────────────────────────────────────
GATEWAY_SERVICE_CLIENT_SECRET=
# Gateway listens on this port (default 8082 in local dev).
GATEWAY_PORT=8082

# ── Audit Service ─────────────────────────────────────────────────────────────
AUDIT_SERVICE_CLIENT_SECRET=

# ── Admin Service ─────────────────────────────────────────────────────────────
# Keycloak client secret for admin-service OIDC (Authorization Code flow).
# Set in Keycloak admin console: Clients → admin-service → Credentials → Client secret.
ADMIN_SERVICE_CLIENT_SECRET=

# SBA server URL used by all SBA clients for instance registration.
ADMIN_SERVICE_URL=http://admin-service:8888

# ── Work Order Service ────────────────────────────────────────────────────────
# PostgreSQL credentials for work-order-service (schema: work_order).
WORK_ORDER_DB_USER=work_order_user
WORK_ORDER_DB_PASSWORD=

# ── Inventory Service ─────────────────────────────────────────────────────────
# PostgreSQL credentials for inventory-service (schema: inventory).
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=
# Internal URL used by gateway routing to inventory-service.
INVENTORY_SERVICE_URL=http://inventory-service:8096

# ── Engineering Service ───────────────────────────────────────────────────────
# PostgreSQL credentials for engineering-service (schema: engineering).
ENGINEERING_DB_USER=engineering_user
ENGINEERING_DB_PASSWORD=
# Internal URL used by gateway routing to engineering-service.
ENGINEERING_SERVICE_URL=http://engineering-service:8097

# PostgreSQL credentials for quality-service (schema: quality).
QUALITY_DB_USER=quality_user
QUALITY_DB_PASSWORD=
# Internal URL used by gateway routing to quality-service.
QUALITY_SERVICE_URL=http://quality-service:8099

# Shared webhook token — must match MES_SECURITY_WEBHOOK_TOKEN across all services.
# Generate with: openssl rand -hex 40
MES_SECURITY_WEBHOOK_TOKEN=

# ── Platform Service ──────────────────────────────────────────────────────────
# PostgreSQL connection for platform-service (schema: platform).
PLATFORM_DB_URL=jdbc:postgresql://localhost:5432/mes?currentSchema=platform
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=

# Internal URL used by gateway routing to platform-service.
PLATFORM_SERVICE_URL=http://platform-service:8090

# ── Audit Service ─────────────────────────────────────────────────────────────
# PostgreSQL credentials for audit-service (schema: audit).
# Generate: openssl rand -hex 16
AUDIT_SERVICE_DB_USERNAME=audit_service
AUDIT_SERVICE_DB_PASSWORD=
AUDIT_FLYWAY_DB_USERNAME=audit_flyway
AUDIT_FLYWAY_DB_PASSWORD=

# Kafka consumer lag threshold for audit-service health indicator.
AUDIT_HEALTH_KAFKA_LAG_THRESHOLD=1000

# Internal URL used by gateway routing to audit-service.
AUDIT_SERVICE_URL=http://audit-service:8091

# Keycloak SPI Kafka publisher — used by lib-keycloak-audit-spi inside Keycloak.
KEYCLOAK_AUDIT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KEYCLOAK_AUDIT_KAFKA_TOPIC=mes.audit.events

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Use kafka:9092 when running inside Docker Compose; localhost:9094 from the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
